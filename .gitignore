# Secrets. The project reads TYPESAFE_API_KEY from the environment; a .env file
# is a convenience for local development and must never be committed.
.env
.env.*
!.env.example

# Virtual environments
venv/
.venv/
env/

# Python build and bytecode
__pycache__/
*.py[cod]
*.egg-info/
build/
dist/

# Test and coverage artifacts
.pytest_cache/
.coverage
.coverage.*
htmlcov/

# Editor and OS noise
.DS_Store
.idea/
.vscode/
